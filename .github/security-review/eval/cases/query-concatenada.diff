+    // busca da lista de pacientes pelo pedaco do nome q a pessoa digitou
+    public List<PatientResponseDTO> searchByName(Long prescriberId, String term) {
+        String jpql = "select p from Patient p where p.prescriber.id = " + prescriberId
+                + " and lower(p.name) like '%" + term.toLowerCase() + "%' order by p.name";
+        return entityManager.createQuery(jpql, Patient.class)
+                .getResultList()
+                .stream()
+                .map(PatientResponseDTO::new)
+                .toList();
+    }


# ---------------------------------------------------------------
# dados sensiveis de paciente
# ---------------------------------------------------------------
# este repositorio e publico. nada que identifique paciente entra aqui.
# formularios preenchidos, planilhas de acompanhamento, exportacoes do
# prontuario e anamneses respondidas ficam fora do versionamento.
dados-sensiveis/
dados-reais/
*.respostas.xlsx
*(respostas)*.xlsx
*(respostas)*.csv
anamnese-preenchida*
prontuario*
/backups/


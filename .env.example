# copie este arquivo pra .env e preencha os valores
# o .env n vai pro git pq esta no gitignore
#
#   cp .env.example .env
#
# depois disso rode docker compose up

# ---------------------------------------------------------------
# banco de dados
# ---------------------------------------------------------------
POSTGRES_DB=doisag
POSTGRES_USER=admindoisag
# troque por uma senha forte
POSTGRES_PASSWORD=

# ---------------------------------------------------------------
# api
# ---------------------------------------------------------------
# chave q assina a sessao e precisa ser longa e aleatoria
# pra gerar uma use openssl rand -base64 48
JWT_SECRET=

# cria os usuarios de teste na subida e em producao fica false
SEED_DADOS_TESTE=false

# o cookie da sessao so trafega em https
# no computador local sem https deixe false e no servidor com https use true
SESSION_SECURE_COOKIE=false

# conta administrativa criada na primeira subida
# ela cria e desativa contas de prescritor e n ve dado clinico
ADMIN_EMAIL=
# use uma senha longa com pelo menos 12 caracteres
ADMIN_PASSWORD=

# endereco onde as pessoas abrem o sistema
# vai nos links enviados por e-mail entao no servidor use o endereco com https
PUBLIC_URL=http://localhost:5173

# ---------------------------------------------------------------
# e-mail
# ---------------------------------------------------------------
# servidor smtp q manda o link de senha nova
# sem MAIL_HOST a api n manda e-mail e o log mostra so destinatario e assunto
# EMAIL_LOG_TEXT=true mostra o texto c/ o link de senha nova, so p/ desenvolvimento
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# endereco do remetente e quando fica vazio vale o MAIL_USERNAME
MAIL_FROM=
# um servidor local de teste sem senha e sem tls costuma pedir false nas duas
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

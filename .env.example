# copie este arquivo pra .env e preencha os valores
# o .env n vai pro git pq esta no gitignore
#
#   cp .env.example .env
#
# depois disso rode docker compose up
# o passo a passo do servidor esta em docs/guia-de-deploy.md

# ---------------------------------------------------------------
# banco de dados
# ---------------------------------------------------------------
POSTGRES_DB=doisag
POSTGRES_USER=admindoisag
# troque por uma senha forte
POSTGRES_PASSWORD=

# ---------------------------------------------------------------
# api
# ---------------------------------------------------------------
# chave q assina a sessao e precisa ser longa e aleatoria
# pra gerar uma use openssl rand -base64 48
# nunca reaproveite chave ou senha q ja apareceu numa versao antiga do repositorio
JWT_SECRET=

# cria as contas de teste na subida, so no proprio computador
# no servidor esta linha nem existe: a api ignora o seed em qualquer endereco https q n seja localhost
# SEED_DADOS_TESTE=true

# chave publica do age q cifra o backup do banco (age-keygen gera o par)
# a privada fica fora do servidor, no cofre da clinica: sem ela nenhum backup abre
# sem essa chave o script de backup se recusa a rodar
BACKUP_AGE_PUBKEY=

# o cookie da sessao so trafega em https, e o compose roda em https tanto no servidor
# quanto no computador, por isso vem true
# precisa combinar com o esquema do PUBLIC_URL, senao a api nem sobe
# so fica false sem docker, com o front no npm run dev em http://localhost:5173
SESSION_SECURE_COOKIE=true

# conta administrativa criada na primeira subida
# ela cria e desativa contas de prescritor e n ve dado clinico
ADMIN_EMAIL=
# use uma senha longa com pelo menos 12 caracteres
ADMIN_PASSWORD=

# endereco onde as pessoas abrem o sistema, com https e sem barra no fim: https://2ag.exemplo.com.br
# vai nos links enviados por e-mail e eh o unico endereco de onde a api aceita requisicao q muda
# dado com o cookie da sessao, entao abra o sistema exatamente por ele
# sem essa variavel a api n sobe
# no proprio computador com o compose vale https://localhost (certificado do scripts/gerar-certificado-local.sh)
# e sem docker, com npm run dev, http://localhost:5173 com SESSION_SECURE_COOKIE=false
PUBLIC_URL=

# ---------------------------------------------------------------
# e-mail
# ---------------------------------------------------------------
# servidor smtp q manda o link de senha nova e o link q confirma a troca do e-mail de acesso
# sem MAIL_HOST a api n manda e-mail e o log mostra so destinatario e assunto
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# endereco do remetente e quando fica vazio vale o MAIL_USERNAME
# com MAIL_HOST preenchido um dos dois precisa ter o endereco, senao a api n sobe
MAIL_FROM=
# um servidor local de teste sem senha e sem tls costuma pedir false nas duas
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
# mostra no log o texto inteiro do e-mail, com o link de senha nova e o de confirmacao do e-mail novo
# so serve pra desenvolvimento, em producao fica false
EMAIL_LOG_TEXT=false

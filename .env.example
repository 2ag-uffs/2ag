# copie este arquivo pra .env e preencha os valores
# o .env nao vai pro git, ele esta no gitignore
#
#   cp .env.example .env
#
# depois disso: docker compose up

# ---------------------------------------------------------------
# banco de dados
# ---------------------------------------------------------------
POSTGRES_DB=doisag
POSTGRES_USER=admindoisag
# troque por uma senha forte
POSTGRES_PASSWORD=

# ---------------------------------------------------------------
# backend
# ---------------------------------------------------------------
# chave que assina os tokens jwt. precisa ser longa e aleatoria
# pra gerar uma: openssl rand -base64 48
JWT_SECRET=

# origem do frontend q o backend aceita nas chamadas (cors)
CORS_ALLOWED_ORIGIN=http://localhost:5173

# cria os usuarios de teste na subida. deixe false em producao,
# senao ele cria um prescritor com senha 123456
SEED_DADOS_TESTE=false

# ---------------------------------------------------------------
# frontend
# ---------------------------------------------------------------
# endereco da api q o frontend vai chamar. isso entra no build,
# entao mudar depois exige rebuildar a imagem
VITE_API_URL=http://localhost:8080
